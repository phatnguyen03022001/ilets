{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-4.7-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-4.7-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-4.7-flash",
    "CLAUDE_CODE_SUBAGENT_MODEL": "glm-4.7-flash",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "80000",
    "MAX_THINKING_TOKENS": "0",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "API_TIMEOUT_MS": "300000",
    "MAX_RETRIES": "2",
    "RETRY_DELAY_MS": "30000"
  },
  "permissions": {
    "allow": ["Bash", "Read", "Write", "Edit", "WebSearch"],
    "deny": []
  },
  "effortLevel": "high",
  "fallbackModel": ["haiku", "glm-4.5-flash"],
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "document-skills@anthropic-agent-skills": true,
    "example-skills@anthropic-agent-skills": false
  }
}