{
  "openapi": "3.0.3",
  "info": {"title": "IELTS Learning System Public API - Bootstrap Slice", "version": "1.0.0-bootstrap.2", "description": "Exact public HTTP contract for bounded Academic Reading TRAINING plus sampled AT-02 ASSESSMENT evidence. Sampled evidence does not declare Band readiness, mastery, product coverage, or certification."},
  "x-session-transport": {"mechanism":"opaque_server_side_session","cookie_name":"ilets_session","http_only":true,"secure_in_production":true,"same_site":"Lax","browser_storage_tokens":false,"server_side_revocation":true,"rotate_on_material_privilege_change":true,"guest_account_association_preserves_learner_identity":true},
  "x-browser-security": {"cors":"deny_except_explicit_web_origins","unsafe_mutations":"require_allowed_origin_when_origin_header_is_present","cross_site_ambiguous_mutation":"fail_closed"},
  "paths": {
    "/healthz": {"get":{"operationId":"getHealth","security":[],"responses":{"200":{"description":"Core process and authoritative database are reachable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Health"}}}},"503":{"$ref":"#/components/responses/InfrastructureUnavailable"}}}},
    "/v1/session": {"post":{"operationId":"bootstrapSession","security":[],"description":"Create an anonymous durable learner session, or return the learner already associated with a valid session cookie. The opaque cookie value is never returned in JSON.","responses":{"201":{"description":"Anonymous learner session established.","headers":{"Set-Cookie":{"description":"Opaque ilets_session cookie; HttpOnly; SameSite=Lax; Secure in production.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Me"}}}},"200":{"description":"Existing valid session reused.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Me"}}}},"403":{"$ref":"#/components/responses/OriginRejected"},"503":{"$ref":"#/components/responses/InfrastructureUnavailable"}}}},
    "/v1/me": {"get":{"operationId":"getMe","security":[{"opaqueSession":[]}],"responses":{"200":{"description":"Current learner identity.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Me"}}}},"401":{"$ref":"#/components/responses/Unauthenticated"}}}},
    "/v1/target-profile": {
      "get":{"operationId":"getTargetProfile","security":[{"opaqueSession":[]}],"responses":{"200":{"description":"Current learner-owned TargetProfile.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TargetProfile"}}}},"401":{"$ref":"#/components/responses/Unauthenticated"},"404":{"$ref":"#/components/responses/NotFound"}}},
      "put":{"operationId":"putTargetProfile","security":[{"opaqueSession":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PutTargetProfileRequest"}}}},"responses":{"200":{"description":"TargetProfile updated.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TargetProfile"}}}},"201":{"description":"TargetProfile created.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TargetProfile"}}}},"400":{"$ref":"#/components/responses/InvalidRequest"},"401":{"$ref":"#/components/responses/Unauthenticated"},"403":{"$ref":"#/components/responses/OriginRejected"},"409":{"$ref":"#/components/responses/Conflict"}}}
    },
    "/v1/practice-modes": {"get":{"operationId":"listPracticeModes","security":[{"opaqueSession":[]}],"responses":{"200":{"description":"Practice modes materialized by this executable slice only; absence of other canonical modes is not a product-support claim.","content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["modes"],"properties":{"modes":{"type":"array","items":{"$ref":"#/components/schemas/PracticeMode"}}}}}}},"401":{"$ref":"#/components/responses/Unauthenticated"}}}},
    "/v1/practice-activities": {"post":{"operationId":"createPracticeActivity","security":[{"opaqueSession":[]}],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePracticeActivityRequest"}}}},"responses":{"201":{"description":"Exact eligible ContentRevision assigned and projected without answer leakage.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PracticeActivity"}}}},"200":{"description":"Idempotent replay of the same authoritative assignment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PracticeActivity"}}}},"400":{"$ref":"#/components/responses/InvalidRequest"},"401":{"$ref":"#/components/responses/Unauthenticated"},"403":{"$ref":"#/components/responses/OriginRejected"},"409":{"$ref":"#/components/responses/Conflict"},"422":{"$ref":"#/components/responses/UnmaterializedTarget"}}}},
    "/v1/practice-activities/{practice_activity_id}": {"parameters":[{"$ref":"#/components/parameters/PracticeActivityId"}],"get":{"operationId":"getPracticeActivity","security":[{"opaqueSession":[]}],"responses":{"200":{"description":"Learner-owned activity projection. Hidden answer material remains absent.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PracticeActivity"}}}},"401":{"$ref":"#/components/responses/Unauthenticated"},"404":{"$ref":"#/components/responses/NotFound"}}}},
    "/v1/assessment-activities": {"post":{"operationId":"createAssessmentActivity","security":[{"opaqueSession":[]}],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateAssessmentActivityRequest"}}}},"responses":{"201":{"description":"Bounded Academic AT-02 assessment assigned without answer leakage.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssessmentActivity"}}}},"200":{"description":"Idempotent replay of the same assessment assignment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssessmentActivity"}}}},"400":{"$ref":"#/components/responses/InvalidRequest"},"401":{"$ref":"#/components/responses/Unauthenticated"},"403":{"$ref":"#/components/responses/OriginRejected"},"409":{"$ref":"#/components/responses/Conflict"},"422":{"$ref":"#/components/responses/UnmaterializedTarget"}}}},
    "/v1/assessment-activities/{assessment_activity_id}": {"parameters":[{"$ref":"#/components/parameters/AssessmentActivityId"}],"get":{"operationId":"getAssessmentActivity","security":[{"opaqueSession":[]}],"responses":{"200":{"description":"Learner-owned assessment projection without hidden answer material.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssessmentActivity"}}}},"401":{"$ref":"#/components/responses/Unauthenticated"},"404":{"$ref":"#/components/responses/NotFound"}}}},
    "/v1/attempts": {"post":{"operationId":"createAttempt","security":[{"opaqueSession":[]}],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateAttemptRequest"}}}},"responses":{"201":{"description":"Draft Attempt created against exact assigned revision.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Attempt"}}}},"200":{"description":"Idempotent replay of the same draft Attempt.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Attempt"}}}},"400":{"$ref":"#/components/responses/InvalidRequest"},"401":{"$ref":"#/components/responses/Unauthenticated"},"403":{"$ref":"#/components/responses/OriginRejected"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Conflict"}}}},
    "/v1/attempts/{attempt_id}": {"parameters":[{"$ref":"#/components/parameters/AttemptId"}],"get":{"operationId":"getAttempt","security":[{"opaqueSession":[]}],"responses":{"200":{"description":"Learner-owned Attempt. Result/feedback is present only after evaluated state.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Attempt"}}}},"401":{"$ref":"#/components/responses/Unauthenticated"},"404":{"$ref":"#/components/responses/NotFound"}}}},
    "/v1/attempts/{attempt_id}/submissions": {"parameters":[{"$ref":"#/components/parameters/AttemptId"}],"post":{"operationId":"submitAttempt","security":[{"opaqueSession":[]}],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubmitAttemptRequest"}}}},"responses":{"200":{"description":"Idempotent deterministic submission/evaluation result. TRAINING remains non-evidence; eligible bounded ASSESSMENT may include a sampled-scope EvidenceFact.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Attempt"}}}},"400":{"$ref":"#/components/responses/InvalidRequest"},"401":{"$ref":"#/components/responses/Unauthenticated"},"403":{"$ref":"#/components/responses/OriginRejected"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Conflict"}}}}
  },
  "components": {
    "securitySchemes":{"opaqueSession":{"type":"apiKey","in":"cookie","name":"ilets_session","description":"Random high-entropy opaque identifier. Server stores only its digest and owns revocation/association state."}},
    "parameters": {
      "IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},"description":"Caller-chosen logical operation identity scoped to current learner and operation."},
      "PracticeActivityId":{"name":"practice_activity_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/ResourceId"}},
      "AssessmentActivityId":{"name":"assessment_activity_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/ResourceId"}},
      "AttemptId":{"name":"attempt_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/ResourceId"}}
    },
    "responses": {
      "InvalidRequest":{"description":"Malformed or semantically invalid request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "Unauthenticated":{"description":"No valid learner session.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "OriginRejected":{"description":"Unsafe browser mutation from an unapproved origin.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "NotFound":{"description":"Resource is absent or not visible to this learner. Response does not disclose cross-learner existence.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "Conflict":{"description":"Idempotency payload conflict, stale resource revision, or illegal lifecycle transition.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "UnmaterializedTarget":{"description":"Target is valid but this bounded executable slice does not materialize that target path. This is not a product-support declaration.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "InfrastructureUnavailable":{"description":"Authoritative infrastructure is unavailable; no learner-performance inference is made.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}
    },
    "schemas": {
      "ResourceId":{"type":"string","minLength":8,"maxLength":80,"pattern":"^[a-z0-9][a-z0-9_-]+$"},
      "CanonicalId":{"type":"string","minLength":2,"maxLength":80},
      "Health":{"type":"object","additionalProperties":false,"required":["status","database","contract_version","build_version"],"properties":{"status":{"type":"string","enum":["ok"]},"database":{"type":"string","enum":["reachable"]},"contract_version":{"type":"string"},"build_version":{"type":"string"}}},
      "Me":{"type":"object","additionalProperties":false,"required":["learner_id","human_actor"],"properties":{"learner_id":{"$ref":"#/components/schemas/ResourceId"},"human_actor":{"type":"string","enum":["Learner"]}}},
      "TestVariant":{"type":"string","enum":["ACADEMIC","GENERAL_TRAINING"]},
      "Band":{"type":"number","minimum":3,"maximum":9,"multipleOf":0.5},
      "TargetProfile":{"type":"object","additionalProperties":false,"required":["test_variant","resource_revision","updated_at"],"properties":{"test_variant":{"$ref":"#/components/schemas/TestVariant"},"target_overall_band":{"$ref":"#/components/schemas/Band"},"minimum_listening_band":{"$ref":"#/components/schemas/Band"},"minimum_reading_band":{"$ref":"#/components/schemas/Band"},"minimum_writing_band":{"$ref":"#/components/schemas/Band"},"minimum_speaking_band":{"$ref":"#/components/schemas/Band"},"resource_revision":{"type":"integer","format":"int64","minimum":1},"updated_at":{"type":"string","format":"date-time"}}},
      "PutTargetProfileRequest":{"type":"object","additionalProperties":false,"required":["test_variant","expected_resource_revision"],"properties":{"test_variant":{"$ref":"#/components/schemas/TestVariant"},"target_overall_band":{"$ref":"#/components/schemas/Band"},"minimum_listening_band":{"$ref":"#/components/schemas/Band"},"minimum_reading_band":{"$ref":"#/components/schemas/Band"},"minimum_writing_band":{"$ref":"#/components/schemas/Band"},"minimum_speaking_band":{"$ref":"#/components/schemas/Band"},"expected_resource_revision":{"type":"integer","format":"int64","minimum":0}},"anyOf":[{"required":["target_overall_band"]},{"required":["minimum_listening_band"]},{"required":["minimum_reading_band"]},{"required":["minimum_writing_band"]},{"required":["minimum_speaking_band"]}]},
      "PracticeMode":{"type":"object","additionalProperties":false,"required":["feature_id","practice_mode_id","practice_type_ids","skill_target_ids","primary_activity_purpose","evidence_candidacy","label"],"properties":{"feature_id":{"type":"string","enum":["R-F04"]},"practice_mode_id":{"type":"string","enum":["PM-R03"]},"practice_type_ids":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string","enum":["PT-13","PT-16"]}},"skill_target_ids":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string","enum":["R-QT-02","R-QT-03"]}},"primary_activity_purpose":{"type":"string","enum":["TRAINING"]},"evidence_candidacy":{"type":"string","enum":["NOT_EVIDENCE_CANDIDATE"]},"label":{"type":"string","enum":["T/F/NG + Y/N/NG"]}}},
      "CreatePracticeActivityRequest":{"type":"object","additionalProperties":false,"required":["practice_mode_id"],"properties":{"practice_mode_id":{"type":"string","enum":["PM-R03"]}}},
      "Choice":{"type":"string","enum":["TRUE","FALSE","NOT_GIVEN","YES","NO"]},
      "ActivityItem":{"type":"object","additionalProperties":false,"required":["item_id","official_family_id","statement","choices"],"properties":{"item_id":{"$ref":"#/components/schemas/ResourceId"},"official_family_id":{"type":"string","enum":["IELTS-R-QF-02","IELTS-R-QF-03"]},"statement":{"type":"string","minLength":1},"choices":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"$ref":"#/components/schemas/Choice"}}}},
      "PracticeActivity":{"type":"object","additionalProperties":false,"required":["practice_activity_id","feature_id","practice_mode_id","practice_type_ids","skill_target_ids","official_family_ids","content_context_id","content_revision_id","primary_activity_purpose","evidence_candidacy","test_variant","stimulus","items","assigned_at"],"properties":{"practice_activity_id":{"$ref":"#/components/schemas/ResourceId"},"feature_id":{"type":"string","enum":["R-F04"]},"practice_mode_id":{"type":"string","enum":["PM-R03"]},"practice_type_ids":{"type":"array","items":{"type":"string","enum":["PT-13","PT-16"]}},"skill_target_ids":{"type":"array","items":{"type":"string","enum":["R-QT-02","R-QT-03"]}},"official_family_ids":{"type":"array","items":{"type":"string","enum":["IELTS-R-QF-02","IELTS-R-QF-03"]}},"content_context_id":{"type":"string","enum":["CTX-READING-ACADEMIC"]},"content_revision_id":{"type":"string","enum":["reading-bootstrap-classification-001-r1","reading-bootstrap-classification-002-r1"]},"primary_activity_purpose":{"type":"string","enum":["TRAINING"]},"evidence_candidacy":{"type":"string","enum":["NOT_EVIDENCE_CANDIDATE"]},"test_variant":{"type":"string","enum":["ACADEMIC"]},"stimulus":{"$ref":"#/components/schemas/LearnerStimulus"},"items":{"type":"array","minItems":1,"items":{"$ref":"#/components/schemas/ActivityItem"}},"assigned_at":{"type":"string","format":"date-time"}}},
      "LearnerStimulus":{"type":"object","additionalProperties":false,"required":["title","text"],"properties":{"title":{"type":"string"},"text":{"type":"string"}}},
      "CreateAssessmentActivityRequest":{"type":"object","additionalProperties":false,"required":["assessment_type_id"],"properties":{"assessment_type_id":{"type":"string","enum":["AT-02"]}}},
      "AssessmentActivity":{"type":"object","additionalProperties":false,"required":["assessment_activity_id","assessment_type_id","feature_id","skill_target_ids","official_family_ids","content_context_id","content_revision_id","primary_activity_purpose","evidence_candidacy","test_variant","stimulus","items","assigned_at"],"properties":{"assessment_activity_id":{"$ref":"#/components/schemas/ResourceId"},"assessment_type_id":{"type":"string","enum":["AT-02"]},"feature_id":{"type":"string","enum":["R-F04"]},"skill_target_ids":{"type":"array","items":{"type":"string","enum":["R-QT-02","R-QT-03"]}},"official_family_ids":{"type":"array","items":{"type":"string","enum":["IELTS-R-QF-02","IELTS-R-QF-03"]}},"content_context_id":{"type":"string","enum":["CTX-READING-ACADEMIC"]},"content_revision_id":{"type":"string","enum":["reading-bootstrap-assessment-001-r1"]},"primary_activity_purpose":{"type":"string","enum":["ASSESSMENT"]},"evidence_candidacy":{"type":"string","enum":["ASSESSMENT_MAY_ADMIT"]},"test_variant":{"type":"string","enum":["ACADEMIC"]},"stimulus":{"$ref":"#/components/schemas/LearnerStimulus"},"items":{"type":"array","minItems":1,"items":{"$ref":"#/components/schemas/ActivityItem"}},"assigned_at":{"type":"string","format":"date-time"}}},
      "CreateAttemptRequest":{"type":"object","additionalProperties":false,"properties":{"practice_activity_id":{"$ref":"#/components/schemas/ResourceId"},"assessment_activity_id":{"$ref":"#/components/schemas/ResourceId"}},"oneOf":[{"required":["practice_activity_id"]},{"required":["assessment_activity_id"]}]},
      "AttemptStatus":{"type":"string","enum":["DRAFT","EVALUATED"]},
      "AnswerInput":{"type":"object","additionalProperties":false,"required":["item_id","choice"],"properties":{"item_id":{"$ref":"#/components/schemas/ResourceId"},"choice":{"$ref":"#/components/schemas/Choice"}}},
      "SubmitAttemptRequest":{"type":"object","additionalProperties":false,"required":["expected_resource_revision","answers"],"properties":{"expected_resource_revision":{"type":"integer","format":"int64","minimum":1},"answers":{"type":"array","minItems":1,"items":{"$ref":"#/components/schemas/AnswerInput"}}}},
      "Attempt":{"type":"object","additionalProperties":false,"required":["attempt_id","content_revision_id","status","resource_revision","created_at"],"properties":{"attempt_id":{"$ref":"#/components/schemas/ResourceId"},"practice_activity_id":{"$ref":"#/components/schemas/ResourceId"},"assessment_activity_id":{"$ref":"#/components/schemas/ResourceId"},"content_revision_id":{"type":"string","enum":["reading-bootstrap-classification-001-r1","reading-bootstrap-classification-002-r1","reading-bootstrap-assessment-001-r1"]},"status":{"$ref":"#/components/schemas/AttemptStatus"},"resource_revision":{"type":"integer","format":"int64","minimum":1},"created_at":{"type":"string","format":"date-time"},"evaluated_at":{"type":"string","format":"date-time"},"observation":{"$ref":"#/components/schemas/Observation"},"evidence_fact":{"$ref":"#/components/schemas/EvidenceFact"},"feedback":{"type":"array","items":{"$ref":"#/components/schemas/ItemFeedback"}}}},
      "Observation":{"type":"object","additionalProperties":false,"required":["observation_id","attempt_id","content_revision_id","content_context_id","skill_target_ids","official_family_ids","scoring_method","raw_score","max_score","primary_activity_purpose","evidence_candidacy","created_at"],"properties":{"observation_id":{"$ref":"#/components/schemas/ResourceId"},"attempt_id":{"$ref":"#/components/schemas/ResourceId"},"content_revision_id":{"type":"string","enum":["reading-bootstrap-classification-001-r1","reading-bootstrap-classification-002-r1","reading-bootstrap-assessment-001-r1"]},"content_context_id":{"type":"string","enum":["CTX-READING-ACADEMIC"]},"skill_target_ids":{"type":"array","items":{"type":"string","enum":["R-QT-02","R-QT-03"]}},"official_family_ids":{"type":"array","items":{"type":"string","enum":["IELTS-R-QF-02","IELTS-R-QF-03"]}},"scoring_method":{"type":"string","enum":["DETERMINISTIC_KEYED"]},"raw_score":{"type":"integer","minimum":0},"max_score":{"type":"integer","minimum":1},"primary_activity_purpose":{"type":"string","enum":["TRAINING","ASSESSMENT"]},"evidence_candidacy":{"type":"string","enum":["NOT_EVIDENCE_CANDIDATE","ASSESSMENT_MAY_ADMIT"]},"created_at":{"type":"string","format":"date-time"}}},
      "EvidenceFact":{"type":"object","additionalProperties":false,"required":["evidence_fact_id","observation_ref","claim_scope","eligibility_status","eligibility_reason","inference_scope","policy_version","admitted_at"],"properties":{"evidence_fact_id":{"$ref":"#/components/schemas/ResourceId"},"observation_ref":{"$ref":"#/components/schemas/ResourceId"},"claim_scope":{"type":"object","additionalProperties":false,"required":["assessment_type_id","test_variant","content_context_id","skill_target_ids"],"properties":{"assessment_type_id":{"type":"string","enum":["AT-02"]},"test_variant":{"type":"string","enum":["ACADEMIC"]},"content_context_id":{"type":"string","enum":["CTX-READING-ACADEMIC"]},"skill_target_ids":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string","enum":["R-QT-02","R-QT-03"]}}}},"eligibility_status":{"type":"string","enum":["ADMITTED"]},"eligibility_reason":{"type":"string","enum":["OBJECTIVE_KEYED_SAMPLED_ASSESSMENT"]},"inference_scope":{"type":"string","enum":["SAMPLED_CLASSIFICATION_PERFORMANCE"]},"policy_version":{"type":"string","enum":["reading-classification-sampled-evidence-v1"]},"admitted_at":{"type":"string","format":"date-time"}}},
      "ItemFeedback":{"type":"object","additionalProperties":false,"required":["item_id","learner_choice","correct_choice","correct","explanation"],"properties":{"item_id":{"$ref":"#/components/schemas/ResourceId"},"learner_choice":{"$ref":"#/components/schemas/Choice"},"correct_choice":{"$ref":"#/components/schemas/Choice"},"correct":{"type":"boolean"},"explanation":{"type":"string"}}},
      "ErrorEnvelope":{"type":"object","additionalProperties":false,"required":["error"],"properties":{"error":{"$ref":"#/components/schemas/ErrorDetail"}}},
      "ErrorDetail":{"type":"object","additionalProperties":false,"required":["code","message","request_id"],"properties":{"code":{"type":"string","pattern":"^[A-Z0-9_]+$"},"message":{"type":"string"},"request_id":{"type":"string"}}}
    }
  }
}
