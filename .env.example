ILETS_ENV=development
BUILD_VERSION=dev

ILETS_POSTGRES_PORT=55432
ILETS_REDIS_PORT=56379
DATABASE_URL=postgres://ilets:ilets@127.0.0.1:55432/ilets?sslmode=disable
REDIS_URL=redis://127.0.0.1:56379/0

CORE_ADDR=127.0.0.1:8080
CORE_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_CORE_API_URL=http://127.0.0.1:8080
EVALUATOR_URL=http://127.0.0.1:8090
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Clerk public authentication boundary
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUDIENCE=ilets-core
# Configure the Clerk Session custom claim `aud` to this exact value.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:3000,http://localhost:3000
